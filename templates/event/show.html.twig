{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} - GeekEvents{% endblock %}

{% block body %}
<div class="relative h-[300px] w-full overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent z-10"></div>
    
    {# Image de couverture #}
    {% if event.imageName %}
        <img src="{{ vich_uploader_asset(event, 'imageFile') }}" 
             class="h-full w-full object-cover opacity-50 blur-sm" alt="Cover">
    {% else %}
        <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=2000&auto=format&fit=crop" 
             class="h-full w-full object-cover opacity-50 blur-sm" alt="Cover">
    {% endif %}
    
    <div class="container relative z-20 h-full flex flex-col justify-end pb-8">
        <div class="mb-4">
            <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-primary/20 text-primary border border-primary/30">
                {{ event.category }}
            </span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-2">{{ event.title }}</h1>
        <div class="flex flex-wrap items-center gap-6 text-muted-foreground text-sm md:text-base">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <span>Du {{ event.startAt|date('d M') }} au {{ event.endAt|date('d M Y') }}</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{{ event.location }}</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Organisé par <span class="text-white font-medium">{{ event.organizer.profile.pseudo }}</span></span>
            </div>
        </div>
    </div>
</div>

<div class="container py-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <div class="lg:col-span-2 space-y-10">
        
        <div class="prose prose-invert max-w-none">
            <h2 class="text-2xl font-bold text-white mb-4">À propos de l'événement</h2>
            <p class="text-gray-300 leading-relaxed text-lg">
                {{ event.description }}
            </p>
        </div>

        <div>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-white">Programme & Activités</h2>
                
                {% if is_granted('ROLE_ORGANIZER') and event.organizer == app.user %}
                    <div class="flex gap-2">
                        <a href="{{ path('app_organizer_add_tournament', {'id': event.id}) }}" class="text-xs md:text-sm bg-purple-600/20 text-purple-400 border border-purple-600/50 hover:bg-purple-600/30 px-3 py-2 rounded-md transition-colors">
                            + Tournoi
                        </a>
                        <a href="{{ path('app_organizer_add_boardgame', {'id': event.id}) }}" class="text-xs md:text-sm bg-orange-600/20 text-orange-400 border border-orange-600/50 hover:bg-orange-600/30 px-3 py-2 rounded-md transition-colors">
                            + Jeu Plateau
                        </a>
                    </div>
                {% endif %}
                </div>

            <div class="space-y-4">
                {% for activity in event.activities %}
                    <div class="group rounded-xl border border-white/10 bg-card p-5 hover:border-primary/50 transition-all">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            
                            <div class="flex items-start gap-4">
                                <div class="p-3 rounded-lg bg-muted text-primary mt-1">
                                    {% if activity.discr == 'tournament' %}
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                                    {% else %}
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><circle cx="9" cy="10" r="1"/><circle cx="15" cy="10" r="1"/><circle cx="12" cy="16" r="1"/></svg>
                                    {% endif %}
                                </div>
                                
                                <div>
                                    <h3 class="font-bold text-lg text-white group-hover:text-primary transition-colors">{{ activity.title }}</h3>
                                    <p class="text-sm text-muted-foreground flex items-center gap-2 mt-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        {{ activity.startAt|date('H:i') }} - {{ activity.room }}
                                    </p>
                                    
                                    <div class="mt-2 text-sm text-gray-400">
                                        {% if activity.discr == 'tournament' %}
                                            <span class="text-purple-400">Jeu : {{ activity.game }}</span> • {{ activity.format }} sur {{ activity.platform }}
                                        {% elseif activity.discr == 'boardgame' %}
                                            <span class="text-orange-400">Jeu : {{ activity.gameName }}</span> • {{ activity.minPlayers }}-{{ activity.maxPlayers }} joueurs
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="w-full md:w-auto">
                                {% if app.user %}
                                    {% if activity.participants.contains(app.user) %}
                                        <a href="{{ path('app_activity_join', {'id': activity.id}) }}" 
                                           class="inline-block w-full md:w-auto px-6 py-2 rounded-md font-medium text-sm border border-red-500/50 text-red-400 hover:bg-red-500/10 transition-all text-center">
                                           Se désinscrire
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_activity_join', {'id': activity.id}) }}" 
                                           class="inline-block w-full md:w-auto px-6 py-2 rounded-md font-medium text-sm border border-input bg-transparent hover:bg-primary hover:text-white hover:border-primary transition-all text-center">
                                           S'inscrire
                                        </a>
                                    {% endif %}
                                {% else %}
                                    <a href="{{ path('app_login') }}" class="inline-block w-full md:w-auto px-6 py-2 rounded-md font-medium text-sm bg-muted text-muted-foreground hover:bg-white/10 transition-all text-center">
                                        Connectez-vous
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted-foreground italic">Aucune activité annoncée pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="space-y-6">
        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
            <h3 class="font-bold text-white mb-4">Détails pratiques</h3>
            <ul class="space-y-4 text-sm">
                <li class="flex justify-between">
                    <span class="text-muted-foreground">Capacité</span>
                    <span class="font-medium text-white">{{ event.capacity }} personnes</span>
                </li>
                <li class="flex justify-between">
                    <span class="text-muted-foreground">Catégorie</span>
                    <span class="font-medium text-white">{{ event.category }}</span>
                </li>
                <li class="flex justify-between">
                    <span class="text-muted-foreground">Statut</span>
                    <span class="px-2 py-0.5 rounded text-xs bg-green-500/10 text-green-400 border border-green-500/20">Confirmé</span>
                </li>
            </ul>

            <div class="mt-6">
                {% if app.user %}
                    {% if event.participants.contains(app.user) %}
                        <a href="{{ path('app_event_register', {'id': event.id}) }}" 
                           class="block w-full text-center bg-red-600/20 text-red-500 border border-red-600/50 font-medium py-3 rounded-md hover:bg-red-600/30 transition-colors">
                            Annuler ma réservation
                        </a>
                    {% else %}
                        <a href="{{ path('app_event_register', {'id': event.id}) }}" 
                           class="block w-full text-center bg-primary text-primary-foreground font-medium py-3 rounded-md hover:bg-primary/90 transition-colors">
                            Réserver ma place
                        </a>
                    {% endif %}
                {% else %}
                    <a href="{{ path('app_login') }}" class="block w-full text-center bg-muted text-muted-foreground font-medium py-3 rounded-md hover:bg-white/10 transition-colors">
                        Connectez-vous pour réserver
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
            <h3 class="font-bold text-white mb-4">Participants ({{ event.participants|length }})</h3>
            
            {% if event.participants is empty %}
                <p class="text-sm text-muted-foreground">Soyez le premier à participer !</p>
            {% else %}
                <div class="flex -space-x-3 overflow-hidden mb-4">
                    {# On affiche les 5 premiers participants #}
                    {% for participant in event.participants|slice(0, 5) %}
                        <img class="inline-block h-10 w-10 rounded-full ring-2 ring-background object-cover" 
                             src="{{ participant.profile.avatarUrl ?? 'https://api.dicebear.com/7.x/avataaars/svg?seed=' ~ participant.email }}" 
                             alt="{{ participant.profile.pseudo ?? 'User' }}"
                             title="{{ participant.profile.pseudo ?? 'Utilisateur' }}">
                    {% endfor %}
                    
                    {% if event.participants|length > 5 %}
                        <div class="flex h-10 w-10 items-center justify-center rounded-full ring-2 ring-background bg-muted text-xs font-medium text-white">
                            +{{ event.participants|length - 5 }}
                        </div>
                    {% endif %}
                </div>
                <p class="text-xs text-muted-foreground">Rejoignez-les à cet événement !</p>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}