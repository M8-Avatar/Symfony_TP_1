{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} - GeekEvents{% endblock %}

{% block body %}
<div class="relative h-[300px] w-full overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent z-10"></div>
    
    {% if event.imageName %}
        <img src="{{ vich_uploader_asset(event, 'imageFile') }}" class="h-full w-full object-cover opacity-50 blur-sm">
    {% else %}
        <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=2000" class="h-full w-full object-cover opacity-50 blur-sm">
    {% endif %}
    
    <div class="container relative z-20 h-full flex flex-col justify-end pb-8">
        <div class="mb-4">
            <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-primary/20 text-primary border border-primary/30">
                {{ event.category }}
            </span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-2">{{ event.title }}</h1>
        <div class="flex flex-wrap items-center gap-6 text-muted-foreground">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <span>Du {{ event.startAt|date('d M') }} au {{ event.endAt|date('d M Y') }}</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{{ event.location }}</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Organisé par <span class="text-white font-medium">{{ event.organizer.profile.pseudo }}</span></span>
            </div>
        </div>
    </div>
</div>

<div class="container py-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <div class="lg:col-span-2 space-y-10">
        <div class="prose prose-invert max-w-none">
            <h2 class="text-2xl font-bold text-white mb-4">À propos de l'événement</h2>
            <p class="text-gray-300 leading-relaxed text-lg">{{ event.description }}</p>
        </div>

        {# --- SECTION 1 : INTERVENANTS / INVITÉS (Gérés par l'admin) --- #}
        {% if event.intervenants is not empty %}
            <div class="mb-10">
                <h2 class="text-2xl font-bold text-white mb-6 border-b-2 border-purple-500 inline-block pb-1">
                    Invités & Intervenants
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for intervenant in event.intervenants %}
                        <div class="flex items-center gap-4 p-4 rounded-xl border border-white/10 bg-[#0B1221] hover:bg-white/5 transition-colors">
                            <div class="relative h-16 w-16 flex-shrink-0">
                                {% if intervenant.imageName %}
                                    <img src="{{ vich_uploader_asset(intervenant, 'imageFile') }}" class="h-full w-full rounded-full border-2 border-purple-500 object-cover">
                                {% else %}
                                    <div class="h-full w-full rounded-full border-2 border-purple-500 bg-purple-500/20 flex items-center justify-center text-purple-300 font-bold text-xl">
                                        {{ intervenant.name|first }}
                                    </div>
                                {% endif %}
                            </div>
                            <div>
                                <div class="font-bold text-lg text-white">{{ intervenant.name }}</div>
                                <p class="text-sm text-gray-400 line-clamp-1">{{ intervenant.bio }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-white">Programme & Activités</h2>
                {% if is_granted('ROLE_ORGANIZER') and event.organizer == app.user %}
                    <div class="flex gap-2">
                        <a href="{{ path('app_organizer_add_tournament', {'id': event.id}) }}" class="text-xs bg-purple-600/20 text-purple-400 border border-purple-600/50 hover:bg-purple-600/30 px-3 py-2 rounded-md">+ Tournoi</a>
                        <a href="{{ path('app_organizer_add_boardgame', {'id': event.id}) }}" class="text-xs bg-orange-600/20 text-orange-400 border border-orange-600/50 hover:bg-orange-600/30 px-3 py-2 rounded-md">+ Jeu</a>
                    </div>
                {% endif %}
            </div>

            <div class="space-y-4">
                {% for activity in event.activities %}
                    <div class="group rounded-xl border border-white/10 bg-card p-5 hover:border-primary/50 transition-all">
                        <div class="flex justify-between items-center gap-4">
                            <div class="flex items-center gap-4">
                                <div class="p-3 rounded-lg bg-muted text-primary">
                                    {% if activity.discr == 'tournament' %}🎮{% else %}🎲{% endif %}
                                </div>
                                <div>
                                    <h3 class="font-bold text-lg text-white">{{ activity.title }}</h3>
                                    <p class="text-sm text-muted-foreground">{{ activity.startAt|date('H:i') }} - {{ activity.room }}</p>
                                </div>
                            </div>
                            <div class="flex flex-col items-end gap-2">
                                <a href="{{ path('app_activity_join', {'id': activity.id}) }}" 
                                class="text-sm px-4 py-2 rounded border font-medium transition-colors
                                {% if app.user and activity.participants.contains(app.user) %}
                                    {# --- STYLE DÉSINSCRIRE (ROUGE) --- #}
                                    border-red-500 text-red-500 hover:bg-red-600 hover:text-white
                                {% else %}
                                    {# --- STYLE S'INSCRIRE (NEUTRE / HOVER PRIMAIRE) --- #}
                                    border-white/20 text-white hover:border-primary hover:bg-primary hover:text-white
                                {% endif %}">
                                    {% if app.user and activity.participants.contains(app.user) %}
                                        Se désinscrire
                                    {% else %}
                                        S'inscrire
                                    {% endif %}
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted-foreground italic">Aucune activité annoncée.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="space-y-6">
        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
            <h3 class="font-bold text-white mb-4">Détails pratiques</h3>
            
            {# --- CALCULS CAPACITÉ --- #}
            {% set registered = event.registrations|length %}
            {% set total = event.capacity %}
            {% set remaining = total - registered %}
            {% if total > 0 %}
                {% set percent = (registered / total) * 100 %}
            {% else %}
                {% set percent = 100 %}
            {% endif %}

            <div class="mb-6">
                <div class="flex justify-between text-sm mb-2">
                    <span class="text-muted-foreground">Places réservées</span>
                    <span class="text-white font-medium">{{ registered }} / {{ total }}</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-2.5 overflow-hidden">
                    <div class="h-2.5 rounded-full {{ remaining == 0 ? 'bg-red-500' : (remaining <= 5 ? 'bg-orange-500' : 'bg-primary') }}" style="width: {{ percent }}%"></div>
                </div>
                {% if remaining <= 5 and remaining > 0 %}
                    <p class="text-xs text-orange-400 mt-2 font-bold">🔥 Vite ! Plus que {{ remaining }} places !</p>
                {% endif %}
            </div>

            <ul class="space-y-4 text-sm mb-6">
                <li class="flex justify-between"><span class="text-muted-foreground">Catégorie</span><span class="font-medium text-white">{{ event.category }}</span></li>
                <li class="flex justify-between"><span class="text-muted-foreground">Statut</span>
                    {% if remaining == 0 %}<span class="px-2 py-0.5 rounded text-xs bg-red-500/10 text-red-400 border border-red-500/20">COMPLET</span>
                    {% else %}<span class="px-2 py-0.5 rounded text-xs bg-green-500/10 text-green-400 border border-green-500/20">Confirmé</span>{% endif %}
                </li>
            </ul>

            <div class="mt-6">
                {% if app.user %}
                    {% set isRegistered = false %}
                    {% for registration in event.registrations %}
                        {% if registration.user == app.user %}{% set isRegistered = true %}{% endif %}
                    {% endfor %}

                    {% if isRegistered %}
                        <a href="{{ path('app_event_register', {'id': event.id}) }}" class="block w-full text-center bg-red-600/20 text-red-500 border border-red-600/50 py-3 rounded-md hover:bg-red-600/30">Annuler ma réservation</a>
                    {% elseif remaining > 0 %}
                        <a href="{{ path('app_event_register', {'id': event.id}) }}" class="block w-full text-center bg-primary text-white py-3 rounded-md hover:bg-primary/90">Réserver ma place</a>
                    {% else %}
                        <button disabled class="block w-full text-center bg-muted text-muted-foreground py-3 rounded-md cursor-not-allowed opacity-75">Événement Complet 😢</button>
                    {% endif %}
                {% else %}
                    <a href="{{ path('app_login') }}" class="block w-full text-center bg-muted text-muted-foreground py-3 rounded-md hover:bg-white/10">Connectez-vous pour réserver</a>
                {% endif %}
            </div>
        </div>

        {# --- SECTION 2 : PARTICIPANTS (Public inscrit via le site) --- #}
        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
            <h3 class="font-bold text-white mb-4">Participants inscrits ({{ event.registrations|length }})</h3>
            {% if event.registrations is empty %}
                <p class="text-sm text-muted-foreground">Soyez le premier à participer !</p>
            {% else %}
                <div class="flex -space-x-3 overflow-hidden mb-4">
                    {% for registration in event.registrations|slice(0, 5) %}
                        {% set participant = registration.user %}
                        <img class="inline-block h-10 w-10 rounded-full ring-2 ring-background object-cover" 
                             src="{{ participant.profile.avatarUrl ?? 'https://api.dicebear.com/7.x/avataaars/svg?seed=' ~ participant.email }}" 
                             title="{{ participant.profile.pseudo }}">
                    {% endfor %}
                    {% if event.registrations|length > 5 %}
                        <div class="flex h-10 w-10 items-center justify-center rounded-full ring-2 ring-background bg-muted text-xs font-medium text-white">+{{ event.registrations|length - 5 }}</div>
                    {% endif %}
                </div>
                <p class="text-xs text-muted-foreground">Rejoignez-les à cet événement !</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}