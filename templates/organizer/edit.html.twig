{% extends 'base.html.twig' %}

{% block title %}Modifier l'événement{% endblock %}

{% block body %}
<div class="container max-w-2xl py-10">
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-white">Modifier : {{ event.title }}</h1>
        <p class="text-muted-foreground mt-2">Mettez à jour les informations de votre événement.</p>
    </div>

    <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
        {{ form_start(form) }}
            
            {# Les widgets utilisent maintenant le thème Tailwind automatiquement #}
            {{ form_widget(form) }}
            
            <div class="pt-6 flex justify-end gap-4 border-t border-white/10 mt-6">
                <a href="{{ path('app_organizer_event_list') }}" class="px-4 py-2 rounded-md text-sm text-gray-400 hover:text-white transition-colors">
                    Annuler
                </a>
                <button type="submit" class="px-6 py-2 rounded-md bg-primary text-white hover:bg-primary/90 text-sm font-medium shadow-lg shadow-primary/20">
                    Enregistrer les modifications
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}