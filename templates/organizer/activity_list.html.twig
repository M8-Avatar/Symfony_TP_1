{% extends 'base.html.twig' %}

{% block title %}Mes Activités - GeekEvents{% endblock %}

{% block body %}
<div class="container py-10">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Gestion des Activités</h1>
            <p class="text-muted-foreground">Pilotez vos Tournois et Jeux de société indépendamment des événements.</p>
        </div>
        <a href="{{ path('app_organizer_event_list') }}" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md font-medium transition-colors">
            + Nouvelle Activité
        </a>
    </div>

    <div class="rounded-xl border border-white/10 bg-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-muted text-muted-foreground uppercase text-xs">
                    <tr>
                        <th class="px-6 py-4 font-medium">Activité</th>
                        <th class="px-6 py-4 font-medium">Type</th>
                        <th class="px-6 py-4 font-medium">Événement Parent</th>
                        <th class="px-6 py-4 font-medium">Participants</th>
                        <th class="px-6 py-4 font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {% for activity in activities %}
                        <tr class="hover:bg-white/5 transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-medium text-white">{{ activity.title }}</div>
                                <div class="text-xs text-gray-500">
                                    {{ activity.startAt|date('d/m/Y H:i') }}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                {% if activity.discr == 'tournament' %}
                                    <span class="px-2 py-1 rounded border border-blue-500/30 bg-blue-500/10 text-blue-400 text-xs font-bold uppercase">Tournoi</span>
                                {% else %}
                                    <span class="px-2 py-1 rounded border border-orange-500/30 bg-orange-500/10 text-orange-400 text-xs font-bold uppercase">Jeu</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-gray-300">
                                {{ activity.event.title }}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-white">{{ activity.participants|length }}</span> inscrits
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right flex justify-end gap-2 items-center h-full">
                                <button class="text-gray-400 hover:text-white" title="Voir les joueurs">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-muted-foreground">
                                Aucune activité créée. Allez dans "Mes événements" pour en ajouter une.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}