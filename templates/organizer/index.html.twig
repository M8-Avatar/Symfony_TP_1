{% extends 'base.html.twig' %}

{% block title %}Dashboard - GeekEvents{% endblock %}

{% block body %}
<div class="container py-10 space-y-12">
    
    <div class="space-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-white">Tableau de bord organisateur</h1>
        <p class="text-muted-foreground text-lg">Vue d'ensemble de vos événements et activités.</p>
        <div class="h-1 w-20 bg-primary rounded-full mt-2"></div>
    </div>

    <div>
        <h2 class="text-2xl font-semibold text-white mb-6 border-b border-white/10 pb-2 inline-block">Actions rapides</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <a href="{{ path('app_organizer_event_new') }}" class="group flex flex-col items-center justify-center p-8 rounded-xl border border-white/10 bg-card hover:border-primary/50 hover:bg-primary/5 transition-all cursor-pointer">
                <div class="h-14 w-14 rounded-full bg-blue-500/10 text-blue-500 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </div>
                <span class="font-medium text-white">Créer un événement</span>
            </a>

            <a href="#my-events" class="group flex flex-col items-center justify-center p-8 rounded-xl border border-white/10 bg-card hover:border-primary/50 hover:bg-primary/5 transition-all cursor-pointer">
                <div class="h-14 w-14 rounded-full bg-purple-500/10 text-purple-500 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <span class="font-medium text-white">Ajouter une activité</span>
            </a>

            <a href="#my-events" class="group flex flex-col items-center justify-center p-8 rounded-xl border border-white/10 bg-card hover:border-primary/50 hover:bg-primary/5 transition-all cursor-pointer">
                <div class="h-14 w-14 rounded-full bg-yellow-500/10 text-yellow-500 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </div>
                <span class="font-medium text-white">Voir mes événements</span>
            </a>

            <div class="group flex flex-col items-center justify-center p-8 rounded-xl border border-white/10 bg-card hover:border-primary/50 hover:bg-primary/5 transition-all cursor-pointer">
                <div class="h-14 w-14 rounded-full bg-red-500/10 text-red-500 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                </div>
                <span class="font-medium text-white">Gérer mes intervenants</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="rounded-xl border border-white/10 bg-card p-6">
            <div class="text-3xl font-bold text-white mb-1">{{ stats.totalEvents }}</div>
            <div class="text-sm text-muted-foreground">Événements créés</div>
        </div>
        <div class="rounded-xl border border-white/10 bg-card p-6">
            <div class="text-3xl font-bold text-white mb-1">{{ stats.totalActivities }}</div>
            <div class="text-sm text-muted-foreground">Activités à venir</div>
        </div>
        <div class="rounded-xl border border-white/10 bg-card p-6">
            <div class="text-3xl font-bold text-white mb-1">{{ stats.totalParticipants }}</div>
            <div class="text-sm text-muted-foreground">Participants inscrits</div>
        </div>
        <div class="rounded-xl border border-white/10 bg-card p-6">
            <div class="text-3xl font-bold text-white mb-1">{{ stats.intervenants }}</div>
            <div class="text-sm text-muted-foreground">Intervenants associés</div>
        </div>
    </div>

    <div>
        <h2 class="text-2xl font-semibold text-white mb-6 border-b border-white/10 pb-2 inline-block">Activités à venir</h2>
        
        {% if upcomingActivities is empty %}
            <div class="text-muted-foreground italic">Aucune activité prévue prochainement.</div>
        {% else %}
            <div class="space-y-4">
                {% for activity in upcomingActivities %}
                    <div class="flex items-center justify-between p-4 rounded-xl border border-white/10 bg-card hover:bg-accent/5 transition-colors">
                        <div class="flex items-center gap-4">
                            <div class="h-12 w-12 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center">
                                {% if activity.discr == 'tournament' %}
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                                {% else %}
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><circle cx="9" cy="10" r="1"/><circle cx="15" cy="10" r="1"/><circle cx="12" cy="16" r="1"/></svg>
                                {% endif %}
                            </div>
                            
                            <div>
                                <h3 class="font-bold text-white">{{ activity.title }}</h3>
                                <div class="flex items-center gap-3 text-sm text-muted-foreground mt-1">
                                    <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold tracking-wider 
                                        {% if activity.discr == 'tournament' %} bg-blue-500/20 text-blue-300 {% else %} bg-orange-500/20 text-orange-300 {% endif %}">
                                        {{ activity.discr == 'tournament' ? 'Tournoi' : 'Jeu de société' }}
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                        {{ activity.startAt|date('d M Y') }}
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        {{ activity.startAt|date('H:i') }} - {{ activity.startAt|date_modify('+2 hours')|date('H:i') }}
                                    </span>
                                    <span class="text-gray-500">{{ activity.event.title }}</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-4">
                            <div class="text-right hidden md:block">
                                <div class="text-sm font-medium text-white">{{ activity.participants|length }} places prises</div>
                                <div class="text-xs text-muted-foreground">sur capacité max</div>
                            </div>
                            <a href="{{ path('app_event_show', {'id': activity.event.id}) }}" class="px-4 py-2 rounded-md border border-blue-500/30 text-blue-400 hover:bg-blue-500/10 text-sm font-medium transition-colors">
                                Gérer
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div>
        <h2 class="text-2xl font-semibold text-white mb-6 border-b border-white/10 pb-2 inline-block">Intervenants associés</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {% for person in intervenants %}
                <div class="flex items-center gap-4 p-4 rounded-xl border border-white/10 bg-card hover:bg-accent/5">
                    <img src="{{ person.profile.avatarUrl ?? 'https://api.dicebear.com/7.x/avataaars/svg?seed=' ~ person.email }}" 
                         alt="{{ person.profile.pseudo }}" 
                         class="h-12 w-12 rounded-full bg-muted border border-white/10">
                    <div>
                        <div class="font-bold text-white">{{ person.profile.pseudo }}</div>
                        <div class="text-xs text-muted-foreground flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            Activités multiples
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-muted-foreground col-span-3">Aucun intervenant (participant) pour le moment.</p>
            {% endfor %}
        </div>
    </div>

    <div id="my-events">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-semibold text-white border-b border-white/10 pb-2 inline-block">Mes événements</h2>
            <a href="{{ path('app_organizer_event_new') }}" class="px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90">
                + Créer un événement
            </a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for event in events %}
                <a href="{{ path('app_event_show', {'id': event.id}) }}" class="group block rounded-xl border border-white/10 bg-card overflow-hidden hover:border-primary/50 transition-all">
                    <div class="relative h-48 w-full bg-muted">
                        {% if event.imageName %}
                            <img src="{{ vich_uploader_asset(event, 'imageFile') }}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100" alt="Cover">
                        {% else %}
                            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800" class="h-full w-full object-cover opacity-80" alt="Defaut">
                        {% endif %}
                        <div class="absolute top-4 left-4">
                            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider rounded-full bg-black/50 backdrop-blur text-white border border-white/20">
                                {{ event.category }}
                            </span>
                        </div>
                    </div>
                    <div class="p-5 space-y-2">
                        <h3 class="font-bold text-lg text-white group-hover:text-primary transition-colors">{{ event.title }}</h3>
                        <div class="text-sm text-gray-400 space-y-1">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                {{ event.startAt|date('d M Y') }}
                            </div>
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                {{ event.location }}
                            </div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}