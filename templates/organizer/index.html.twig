{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - GeekEvents{% endblock %}

{% block body %}
<div class="container py-10 space-y-10">
    
    <div class="space-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-white">Tableau de bord organisateur</h1>
        <p class="text-muted-foreground text-lg">Vue d'ensemble de vos événements et activités.</p>
        <div class="h-1 w-20 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full mt-2"></div>
    </div>

    {% if nextEvent %}
        <div class="rounded-xl bg-gradient-to-r from-indigo-900 to-blue-900 p-6 border border-indigo-500/30 shadow-lg relative overflow-hidden">
            <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h3 class="text-indigo-300 font-medium uppercase tracking-wider text-sm mb-1">Prochain événement</h3>
                    <h2 class="text-2xl md:text-3xl font-bold text-white">{{ nextEvent.title }}</h2>
                    <p class="text-indigo-200 flex items-center gap-2 mt-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                        {{ nextEvent.startAt|date('d F Y à H:i') }}
                    </p>
                </div>

                <div class="flex gap-4 text-center" id="countdown-timer" data-date="{{ nextEvent.startAt|date('Y-m-d H:i:s') }}">
                    <div class="bg-black/30 rounded-lg p-3 w-20 backdrop-blur-sm">
                        <span class="block text-2xl font-bold text-white" id="days">00</span>
                        <span class="text-xs text-indigo-300 uppercase">Jours</span>
                    </div>
                    <div class="bg-black/30 rounded-lg p-3 w-20 backdrop-blur-sm">
                        <span class="block text-2xl font-bold text-white" id="hours">00</span>
                        <span class="text-xs text-indigo-300 uppercase">Heures</span>
                    </div>
                    <div class="bg-black/30 rounded-lg p-3 w-20 backdrop-blur-sm">
                        <span class="block text-2xl font-bold text-white" id="minutes">00</span>
                        <span class="text-xs text-indigo-300 uppercase">Min</span>
                    </div>
                    <div class="bg-black/30 rounded-lg p-3 w-20 backdrop-blur-sm">
                        <span class="block text-2xl font-bold text-white" id="seconds">00</span>
                        <span class="text-xs text-indigo-300 uppercase">Sec</span>
                    </div>
                </div>
            </div>
            
            <div class="absolute right-0 top-0 h-full w-1/2 bg-gradient-to-l from-indigo-500/10 to-transparent"></div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const timerElement = document.getElementById('countdown-timer');
                if (!timerElement) return;

                // Conversion de la date Twig en Timestamp JS
                const eventDate = new Date(timerElement.dataset.date).getTime();

                const updateTimer = () => {
                    const now = new Date().getTime();
                    const distance = eventDate - now;

                    if (distance < 0) {
                        timerElement.innerHTML = '<div class="text-white font-bold text-xl">L\'événement a commencé !</div>';
                        return;
                    }

                    document.getElementById('days').innerText = Math.floor(distance / (1000 * 60 * 60 * 24));
                    document.getElementById('hours').innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    document.getElementById('minutes').innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    document.getElementById('seconds').innerText = Math.floor((distance % (1000 * 60)) / 1000);
                };

                setInterval(updateTimer, 1000);
                updateTimer(); 
            });
        </script>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm relative overflow-hidden group">
            <div class="flex items-center gap-4">
                <div class="p-3 rounded-lg bg-blue-500/10 text-blue-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                </div>
            </div>
            <div class="mt-4">
                <div class="text-3xl font-bold text-white">{{ stats.totalEvents }}</div>
                <div class="text-sm text-muted-foreground font-medium">Événements créés</div>
            </div>
        </div>
        
        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
            <div class="flex items-center gap-4">
                <div class="p-3 rounded-lg bg-purple-500/10 text-purple-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                </div>
            </div>
            <div class="mt-4">
                <div class="text-3xl font-bold text-white">{{ stats.totalActivities }}</div>
                <div class="text-sm text-muted-foreground font-medium">Activités organisées</div>
            </div>
        </div>
        
        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
            <div class="flex items-center gap-4">
                <div class="p-3 rounded-lg bg-yellow-500/10 text-yellow-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
            </div>
            <div class="mt-4">
                <div class="text-3xl font-bold text-white">{{ stats.totalParticipants }}</div>
                <div class="text-sm text-muted-foreground font-medium">Participants inscrits</div>
            </div>
        </div>

        <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
            <div class="flex items-center gap-4">
                <div class="p-3 rounded-lg bg-red-500/10 text-red-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
                </div>
            </div>
            <div class="mt-4">
                <div class="text-3xl font-bold text-white">{{ stats.intervenants }}</div>
                <div class="text-sm text-muted-foreground font-medium">Intervenants associés</div>
            </div>
        </div>
    </div>

    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-semibold text-white">Mes événements</h2>
                <div class="h-1 w-10 bg-blue-600 rounded-full mt-1"></div>
            </div>
            
            <a href="{{ path('app_organizer_event_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700 h-10 px-6 py-2 transition-all shadow-lg shadow-indigo-500/20">
                + Créer un événement
            </a>
        </div>
        
        {% if events is empty %}
            <div class="text-center py-16 border border-dashed border-white/10 rounded-xl bg-card/50">
                <p class="text-muted-foreground text-lg">Vous n'avez organisé aucun événement pour le moment.</p>
                <button class="mt-4 text-primary hover:underline">Commencer maintenant</button>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for event in events %}
                    <div class="group rounded-xl border border-white/10 bg-card text-card-foreground shadow-sm overflow-hidden hover:border-primary/50 transition-all duration-300">
                        
                        <a href="{{ path('app_event_show', {'id': event.id}) }}" class="block relative h-48 w-full overflow-hidden bg-muted">
                            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800&auto=format&fit=crop" 
                                 alt="{{ event.title }}" 
                                 class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100">
                            
                            <div class="absolute top-4 left-4">
                                <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full 
                                    {% if event.category == 'Tournoi E-sport' %} bg-purple-500/20 text-purple-300 border border-purple-500/30
                                    {% elseif event.category == 'Convention' %} bg-blue-500/20 text-blue-300 border border-blue-500/30
                                    {% else %} bg-orange-500/20 text-orange-300 border border-orange-500/30 {% endif %} backdrop-blur-md">
                                    {{ event.category }}
                                </span>
                            </div>
                        </a>

                        <div class="p-6 space-y-4">
                            <a href="{{ path('app_event_show', {'id': event.id}) }}" class="block font-bold text-xl leading-none text-white group-hover:text-primary transition-colors">
                                {{ event.title }}
                            </a>
                            
                            <div class="space-y-2 text-sm text-gray-400">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                    <span>{{ event.startAt|date('d M Y') }} - {{ event.endAt|date('d M Y') }}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                    <span>{{ event.location }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}