{% extends 'base.html.twig' %}

{% block title %}Ajouter {{ type }}{% endblock %}

{% block body %}
<div class="container max-w-2xl py-10">
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-white">Ajouter : {{ type }}</h1>
        <p class="text-muted-foreground">Pour l'événement : <span class="text-primary">{{ event.title }}</span></p>
    </div>

    <div class="rounded-xl border border-white/10 bg-card p-6 shadow-sm">
        {{ form_start(form) }}
            
            <style>
                /* Petite astuce CSS rapide pour tes formulaires */
                .form-input, .form-textarea, select {
                    width: 100%;
                    border-radius: 0.375rem;
                    border: 1px solid hsl(var(--input));
                    background-color: hsl(var(--background));
                    padding: 0.5rem 0.75rem;
                    font-size: 0.875rem;
                    color: white;
                    margin-bottom: 1rem;
                }
                .form-input:focus { outline: 2px solid hsl(var(--primary)); }
                label { display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 500; color: #e5e7eb; }
            </style>

            {# Affichage automatique de tous les champs #}
            {{ form_widget(form) }}

            <div class="pt-4 flex justify-end gap-4">
                <a href="{{ path('app_event_show', {'id': event.id}) }}" class="px-4 py-2 rounded-md border border-input bg-transparent hover:bg-accent text-white text-sm">
                    Annuler
                </a>
                <button type="submit" class="px-6 py-2 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 text-sm font-medium">
                    Enregistrer l'activité
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}