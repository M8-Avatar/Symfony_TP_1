{% extends 'base.html.twig' %}

{% block title %}Mes Intervenants{% endblock %}

{% block body %}
<div class="container py-10">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Gestion des Intervenants</h1>
            <p class="text-muted-foreground">Gérez les invités et speakers de vos événements.</p>
        </div>
        <a href="{{ path('app_intervenant_new') }}" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md font-medium transition-colors flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Ajouter un intervenant
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for intervenant in intervenants %}
            <div class="group relative flex items-center gap-4 p-4 rounded-xl border border-white/10 bg-[#0B1221] hover:border-green-500/50 transition-all">
                
                <div class="relative h-16 w-16 flex-shrink-0">
                    {% if intervenant.imageName %}
                        <img src="{{ vich_uploader_asset(intervenant, 'imageFile') }}" class="h-full w-full rounded-full border-2 border-primary object-cover">
                    {% else %}
                        <div class="h-full w-full rounded-full border-2 border-primary bg-primary/20 flex items-center justify-center text-primary font-bold text-xl">
                            {{ intervenant.name|first }}
                        </div>
                    {% endif %}
                </div>

                <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-bold text-white truncate">{{ intervenant.name }}</h3>
                    <p class="text-sm text-muted-foreground truncate">{{ intervenant.bio ?? 'Aucune bio' }}</p>
                </div>

                <div class="flex items-center gap-2">
                    <a href="{{ path('app_intervenant_edit', {'id': intervenant.id}) }}" class="p-2 text-blue-400 hover:bg-blue-500/10 rounded-lg transition-colors" title="Modifier">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </a>
                    
                    <form method="post" action="{{ path('app_intervenant_delete', {'id': intervenant.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet intervenant ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ intervenant.id) }}">
                        <button class="p-2 text-red-400 hover:bg-red-500/10 rounded-lg transition-colors" title="Supprimer">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <div class="col-span-3 text-center py-12 border border-dashed border-white/10 rounded-xl">
                <p class="text-muted-foreground">Aucun intervenant pour le moment.</p>
            </div>
        {% endfor %}
    </div>
    
    <div class="mt-8">
        <a href="{{ path('app_organizer_dashboard') }}" class="text-muted-foreground hover:text-white transition-colors flex items-center gap-2">
            ← Retour au Dashboard
        </a>
    </div>
</div>
{% endblock %}