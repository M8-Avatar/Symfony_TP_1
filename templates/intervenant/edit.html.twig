{% extends 'base.html.twig' %}

{% block title %}Modifier Intervenant{% endblock %}

{% block body %}
<div class="container py-10 max-w-2xl">
    <h1 class="text-3xl font-bold text-white mb-8">Modifier {{ intervenant.name }}</h1>

    <div class="bg-card border border-white/10 rounded-xl p-6 shadow-sm">
        {{ form_start(form) }}
            
            {{ form_widget(form) }}

            <div class="flex items-center justify-end gap-4 pt-4 border-t border-white/10 mt-6">
                <a href="{{ path('app_intervenant_index') }}" class="text-gray-400 hover:text-white text-sm transition-colors">Annuler</a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md font-medium text-sm transition-colors shadow-lg shadow-blue-500/20">
                    Mettre à jour
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}