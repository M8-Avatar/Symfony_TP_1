{% extends 'base.html.twig' %}

{% block title %}Accueil - GeekEvents{% endblock %}

{% block body %}
    <section class="relative overflow-hidden py-24 lg:py-32 bg-slate-900">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent"></div>

        <div class="container relative z-10 flex flex-col items-center text-center">
            <h1 class="text-4xl font-extrabold tracking-tight lg:text-6xl mb-6">
                Vivez vos événements <span class="text-primary">Geek</span>
            </h1>
            <p class="max-w-[700px] text-lg text-muted-foreground mb-8">
                Tournois e-sport, conventions, soirées jeux de société, projections... 
                Retrouvez tous les événements majeurs au même endroit.
            </p>
            <div class="flex gap-4">
                <a href="#events" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90">
                    Voir les événements
                </a>
                <a href="{{ path('app_organizer_event_new') }}" class="inline-flex h-11 items-center justify-center rounded-md border border-input bg-background px-8 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
                    Créer un événement
                </a>
            </div>
        </div>
    </section>

    <section id="events" class="container py-12 space-y-8">
        <div class="flex items-center justify-between">
            <h2 class="text-3xl font-bold tracking-tight">Prochains événements</h2>
            <a href="#" class="text-sm text-primary hover:underline">Voir tout →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for event in events %}
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm hover:shadow-md transition-shadow hover:border-primary/50">
                    <div class="p-6 pb-4 space-y-1">
                        <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground border-primary/30 bg-primary/10 mb-2">
                            {{ event.category }}
                        </span>
                        <h3 class="font-semibold leading-none tracking-tight text-xl">
                            {{ event.title }}
                        </h3>
                        <p class="text-sm text-muted-foreground">
                            Organisé par {{ event.organizer.profile.pseudo }}
                        </p>
                    </div>
                    <div class="p-6 pt-0 space-y-3">
                        <div class="text-sm text-muted-foreground flex flex-col gap-1">
                            <div class="flex items-center gap-2">
                                📅 <span>{{ event.startAt|date('d/m/Y') }}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                📍 <span>{{ event.location }}</span>
                            </div>
                        </div>
                        
                        <p class="text-sm text-gray-400 line-clamp-2">
                            {{ event.description }}
                        </p>

                        <a href="{{ path('app_event_show', {'id': event.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 py-2 w-full mt-2">
                            Voir détails
                        </a>
                    </div>
                </div>
            {% else %}
                <p class="text-muted-foreground col-span-3 text-center py-10">
                    Aucun événement prévu pour le moment.
                </p>
            {% endfor %}
        </div>
    </section>
{% endblock %}