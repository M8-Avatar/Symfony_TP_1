{% extends 'base.html.twig' %}

{% block title %}Accueil - GeekEvents{% endblock %}

{% block body %}
    
    <section class="relative overflow-hidden py-24 lg:py-32 bg-slate-900">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent"></div>

        <div class="container relative z-10 flex flex-col items-center text-center">
            <h1 class="text-4xl font-extrabold tracking-tight lg:text-6xl mb-6">
                Vivez vos événements <span class="text-primary">Geek</span>
            </h1>
            <p class="max-w-[700px] text-lg text-muted-foreground mb-8">
                Tournois e-sport, conventions, soirées jeux de société, projections... 
                Retrouvez tous les événements majeurs au même endroit.
            </p>
            <div class="flex gap-4">
                <a href="#events" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90">
                    Voir les événements
                </a>
                {% if is_granted('ROLE_ORGANIZER') %}
                    <a href="{{ path('app_organizer_event_new') }}" class="text-sm font-semibold leading-6 text-white border border-white/20 px-4 py-2 rounded-md hover:bg-white/10 transition-colors flex items-center">
                        Créer un événement
                    </a>
                {% endif %}
            </div>
        </div>
    </section>

    <section id="events" class="container py-12 space-y-8">
        
        <div class="p-6 rounded-2xl border border-white/10 bg-card shadow-lg">
            <form method="get" action="{{ path('app_home') }}#events" class="grid grid-cols-1 md:grid-cols-12 gap-4">
                
                <div class="md:col-span-5 relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-muted-foreground">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                    <input type="text" name="q" value="{{ currentSearch }}" 
                           placeholder="Rechercher un événement (ex: Zelda, Tournoi...)" 
                           class="w-full pl-10 h-12 rounded-lg bg-background border border-input text-foreground focus:ring-2 focus:ring-primary focus:border-transparent transition-all">
                </div>

                <div class="md:col-span-4 relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-muted-foreground">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    </div>
                    <select name="category" class="w-full pl-10 h-12 rounded-lg bg-background border border-input text-foreground focus:ring-2 focus:ring-primary focus:border-transparent appearance-none cursor-pointer">
                        <option value="">Toutes les catégories</option>
                        <option value="Convention" {{ currentCategory == 'Convention' ? 'selected' : '' }}>Convention</option>
                        <option value="Tournoi E-sport" {{ currentCategory == 'Tournoi E-sport' ? 'selected' : '' }}>Tournoi E-sport</option>
                        <option value="Soirée Jeux" {{ currentCategory == 'Soirée Jeux' ? 'selected' : '' }}>Soirée Jeux</option>
                        <option value="Conférence" {{ currentCategory == 'Conférence' ? 'selected' : '' }}>Conférence</option>
                    </select>
                </div>

                <div class="md:col-span-3 flex gap-2">
                    <button type="submit" class="flex-1 h-12 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg transition-colors flex items-center justify-center gap-2">
                        Filtrer
                    </button>
                    
                    {% if currentSearch or currentCategory %}
                        <a href="{{ path('app_home') }}#events" class="px-4 h-12 border border-red-500/30 text-red-400 hover:bg-red-500/10 rounded-lg flex items-center justify-center transition-colors" title="Réinitialiser">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </a>
                    {% endif %}
                </div>
            </form>
        </div>

        <div class="flex items-center justify-between pt-4">
            <h2 class="text-3xl font-bold tracking-tight">
                {% if currentSearch or currentCategory %}
                    Résultats de recherche
                {% else %}
                    Prochains événements
                {% endif %}
            </h2>
            <div class="text-sm text-muted-foreground">{{ events|length }} événement(s) trouvé(s)</div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for event in events %}
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm hover:shadow-md transition-shadow hover:border-primary/50 flex flex-col h-full">
                    <div class="p-6 pb-4 space-y-1 flex-1">
                        <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground border-primary/30 bg-primary/10 mb-2">
                            {{ event.category }}
                        </span>
                        <h3 class="font-semibold leading-none tracking-tight text-xl">
                            {{ event.title }}
                        </h3>
                        <p class="text-sm text-muted-foreground mt-1">
                            Organisé par {{ event.organizer.profile.pseudo }}
                        </p>
                    </div>
                    
                    <div class="p-6 pt-0 space-y-3 mt-auto">
                        <div class="text-sm text-muted-foreground flex flex-col gap-1 border-t border-white/5 pt-4">
                            <div class="flex items-center gap-2">
                                📅 <span>{{ event.startAt|date('d/m/Y') }}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                📍 <span>{{ event.location }}</span>
                            </div>
                        </div>
                        
                        <p class="text-sm text-gray-400 line-clamp-2 min-h-[2.5em]">
                            {{ event.description }}
                        </p>

                        <a href="{{ path('app_event_show', {'id': event.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 py-2 w-full">
                            Voir détails
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="col-span-3 text-center py-20 bg-card/50 rounded-xl border border-dashed border-white/10">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-muted mb-4">
                        <svg class="w-8 h-8 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                    <h3 class="text-xl font-medium text-white">Aucun événement trouvé</h3>
                    <p class="text-muted-foreground mt-2">Essayez de modifier vos critères de recherche.</p>
                    <a href="{{ path('app_home') }}#events" class="inline-block mt-4 text-primary hover:underline font-medium">Réinitialiser les filtres</a>
                </div>
            {% endfor %}
        </div>
    </section>

{% endblock %}