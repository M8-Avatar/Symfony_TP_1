{% extends 'base.html.twig' %}

{% block title %}Accueil - GeekEvents{% endblock %}

{% block body %}
    
    <section class="relative overflow-hidden py-24 lg:py-32 bg-slate-900">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent"></div>

        <div class="container relative z-10 flex flex-col items-center text-center">
            <h1 class="text-4xl font-extrabold tracking-tight lg:text-6xl mb-6">
                Vivez vos événements <span class="text-primary">Geek</span>
            </h1>
            <p class="max-w-[700px] text-lg text-muted-foreground mb-8">
                Tournois e-sport, conventions, soirées jeux de société, projections... 
                Retrouvez tous les événements majeurs au même endroit.
            </p>
            <div class="flex gap-4">
                <a href="#events" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90">
                    Voir les événements
                </a>
                {% if is_granted('ROLE_ORGANIZER') %}
                    <a href="{{ path('app_organizer_event_new') }}" class="text-sm font-semibold leading-6 text-white border border-white/20 px-4 py-2 rounded-md hover:bg-white/10 transition-colors flex items-center">
                        Créer un événement
                    </a>
                {% endif %}
            </div>
        </div>
    </section>

    <section id="events" class="container py-12 space-y-8">
        
        <div class="p-6 rounded-2xl border border-white/10 bg-card shadow-lg">
            <form method="get" action="{{ path('app_home') }}#events" class="grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-5 relative">
                    <input type="text" name="q" value="{{ currentSearch }}" placeholder="Rechercher..." class="w-full pl-4 h-12 rounded-lg bg-background border border-input text-foreground focus:ring-2 focus:ring-primary">
                </div>
                <div class="md:col-span-4 relative">
                    <select name="category" class="w-full pl-4 h-12 rounded-lg bg-background border border-input text-foreground focus:ring-2 focus:ring-primary appearance-none cursor-pointer">
                        <option value="">Toutes les catégories</option>
                        <option value="Convention" {{ currentCategory == 'Convention' ? 'selected' : '' }}>Convention</option>
                        <option value="Tournoi E-sport" {{ currentCategory == 'Tournoi E-sport' ? 'selected' : '' }}>Tournoi E-sport</option>
                        <option value="Soirée Jeux" {{ currentCategory == 'Soirée Jeux' ? 'selected' : '' }}>Soirée Jeux</option>
                        <option value="Conférence" {{ currentCategory == 'Conférence' ? 'selected' : '' }}>Conférence</option>
                    </select>
                </div>
                <div class="md:col-span-3 flex gap-2">
                    <button type="submit" class="flex-1 h-12 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg transition-colors">Filtrer</button>
                    {% if currentSearch or currentCategory %}
                        <a href="{{ path('app_home') }}#events" class="px-4 h-12 border border-red-500/30 text-red-400 hover:bg-red-500/10 rounded-lg flex items-center justify-center">X</a>
                    {% endif %}
                </div>
            </form>
        </div>

        <div class="flex items-center justify-between pt-4">
            <h2 class="text-3xl font-bold tracking-tight">Prochains événements</h2>
            <div class="text-sm text-muted-foreground">{{ events|length }} trouvé(s)</div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for event in events %}
                
                {# --- CALCULS CAPACITÉ --- #}
                {% set registered = event.registrations|length %}
                {% set capacity = event.capacity %}
                {% set remaining = capacity - registered %}
                {% set isFirst = loop.first %}

                <a href="{{ path('app_event_show', {'id': event.id}) }}" class="group rounded-lg border {{ isFirst ? 'border-primary shadow-[0_0_20px_rgba(59,130,246,0.2)]' : 'border-white/10' }} bg-card text-card-foreground shadow-sm hover:shadow-md transition-all hover:-translate-y-1 hover:border-primary/50 flex flex-col h-full overflow-hidden relative">
                    
                    {% if isFirst %}
                        <div class="absolute top-3 left-3 z-20 bg-primary text-white text-[10px] font-bold px-2 py-1 rounded shadow-lg animate-bounce">
                            Bientôt !
                        </div>
                    {% endif %}

                    <div class="relative h-48 bg-muted">
                        {% if event.imageName %}
                            <img src="{{ vich_uploader_asset(event, 'imageFile') }}" class="h-full w-full object-cover transition-transform hover:scale-105" alt="{{ event.title }}">
                        {% else %}
                            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800" class="h-full w-full object-cover opacity-80" alt="Defaut">
                        {% endif %}
                        <div class="absolute top-3 right-3">
                            <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground border-black/30 bg-black/60 backdrop-blur text-white">
                                {{ event.category }}
                            </span>
                        </div>
                    </div>

                    <div class="p-6 pb-4 space-y-1 flex-1">
                        <h3 class="font-semibold leading-none tracking-tight text-xl mb-2">{{ event.title }}</h3>
                        <p class="text-sm text-muted-foreground">Organisé par {{ event.organizer.profile.pseudo }}</p>
                        
                        <div class="mt-3">
                            {% if remaining <= 0 %}
                                <span class="inline-flex items-center rounded-md bg-red-500/10 px-2 py-1 text-xs font-medium text-red-400 ring-1 ring-inset ring-red-500/20">COMPLET</span>
                            {% elseif remaining <= 5 %}
                                <span class="inline-flex items-center rounded-md bg-orange-500/10 px-2 py-1 text-xs font-medium text-orange-400 ring-1 ring-inset ring-orange-500/20">🔥 Plus que {{ remaining }} places !</span>
                            {% else %}
                                <span class="inline-flex items-center rounded-md bg-green-500/10 px-2 py-1 text-xs font-medium text-green-400 ring-1 ring-inset ring-green-500/20">{{ registered }} / {{ capacity }} inscrits</span>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="p-6 pt-0 space-y-3 mt-auto">
                        <div class="text-sm text-muted-foreground flex flex-col gap-1 border-t border-white/5 pt-4">
                            <div class="flex items-center gap-2">📅 <span>{{ event.startAt|date('d/m/Y') }}</span></div>
                            <div class="flex items-center gap-2">📍 <span>{{ event.location }}</span></div>
                        </div>
                        <div class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 py-2 w-full mt-4">
                            Voir détails
                        </div>
                    </div>
                </a>
            {% else %}
                <div class="col-span-3 text-center py-20 bg-card/50">
                    <h3 class="text-xl font-medium text-white">Aucun événement trouvé</h3>
                </div>
            {% endfor %}
        </div>
    </section>

{% endblock %}