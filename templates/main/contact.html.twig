{% extends 'base.html.twig' %}

{% block title %}Contact - GeekEvents{% endblock %}

{% block body %}
<div class="container max-w-2xl py-12">
    <div class="mb-10 text-center">
        <h1 class="text-4xl font-bold text-white mb-4">Contactez-nous</h1>
        <p class="text-muted-foreground">Une question sur un événement ou un problème technique ?</p>
    </div>

    <div class="rounded-xl border border-white/10 bg-[#0B1221] p-8 shadow-lg">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
            </div>

            {{ form_row(form.subject) }}
            {{ form_row(form.message) }}

            <div class="pt-4 flex justify-end">
                <button type="submit" class="bg-primary hover:bg-primary/90 text-white px-8 py-3 rounded-md font-bold transition-all shadow-lg shadow-primary/20 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                    Envoyer le message
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}