{% extends 'base.html.twig' %}

{% block title %}Inscription - GeekEvents{% endblock %}

{% block body %}
<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-background p-4">
    <div class="w-full max-w-md space-y-6">
        
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-8 border-primary/20">
            <div class="flex flex-col space-y-1.5 text-center mb-6">
                <h1 class="text-2xl font-bold tracking-tight">Inscription</h1>
                <p class="text-sm text-muted-foreground">Rejoignez la communauté GeekEvents.</p>
            </div>

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
                
                {% if form_errors(registrationForm) %}
                    <div class="bg-red-900/30 text-red-200 p-3 rounded text-sm border border-red-500/50">
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}

                <div class="space-y-2">
                    <label class="text-sm font-medium leading-none">Email</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2', 'placeholder': 'votre@email.com'}}) }}
                    <div class="text-red-400 text-xs">{{ form_errors(registrationForm.email) }}</div>
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-medium leading-none">Mot de passe</label>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2', 'placeholder': '********'}}) }}
                    <div class="text-red-400 text-xs">{{ form_errors(registrationForm.plainPassword) }}</div>
                </div>

                <div class="flex items-center space-x-2 pt-2">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'h-4 w-4 rounded border-primary text-primary focus:ring-primary'}}) }}
                    <label class="text-sm text-muted-foreground">J'accepte les conditions d'utilisation</label>
                </div>

                <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 w-full">
                    Créer mon compte
                </button>
            {{ form_end(registrationForm) }}

            <div class="mt-4 text-center text-sm">
                Déjà un compte ? 
                <a href="{{ path('app_login') }}" class="text-primary hover:underline font-medium">Se connecter</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}